  "policy": {
    "intent_descriptions": {
      "finish_task": "Satisfy the original LIBERO basket-containment goal.",
      "align_gripper": "Move the open fingerpad midpoint toward the target collision-shape center while the object fits the jaw opening. Limit ungrasped object pushing.",
      "orient_to_fit": "Reduce target width along the jaw-closing axis when it exceeds available opening.",
      "open_for_grasp": "Increase an insufficient jaw opening for the target width.",
      "close_for_grasp": "Reduce the jaw opening around an already aligned object.",
      "secure_target": "Establish simultaneous left AND right fingerpad contact. Lifting will test whether it is actually carried.",
      "lift_target": "Raise the held object until its bottom clears the basket rim; preserve bilateral pad contact.",
      "carry_target": "Reduce object-to-basket horizontal error while keeping the held object clear of the rim and external contacts.",
      "lower_into_goal": "Lower the held object over the basket center, reducing distance to its containment region.",
      "release_in_goal": "Release the object over the basket with predicted progress into the containment region.",
      "release_obstruction": "Remove currently obstructing gripper contacts, preserving any two-sided grip.",
      "reposition": "First input with a safe two-step witness to a net physical effect. The next input is reselected after observation."
    },
    "motor_instructions": "Choose one input for the selected objective. Prefer larger useful measured improvement: jaw-center alignment for align_gripper, sufficient aperture for open_for_grasp, bilateral contact for securing, object height for lift, horizontal goal progress for carry, and distance reduction for lowering. Preserve the held object during lift/transport. For reposition compare the two-step witness. Only the selected input executes.",
    "intent_instructions": "Choose a feasible physical objective for picking up the target and placing it in the basket. Prefer task completion. A two-sided grip enables lifting; clearing the basket rim enables transport. An aligned open jaw enables closing. Prefer preserving a useful grip over releasing it away from the destination. Compare the measured state and candidate effects.",
    "strategy_instructions": "Choose a contact/motion family that best realizes the selected objective. Compare target alignment, two-sided fingerpad contact, object lift, and distance to the basket. Every option describes a simulated short input.",
    "task_text": "Pick up the alphabet soup and place it in the basket.",
